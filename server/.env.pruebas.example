# Ambiente de PRUEBAS (SQL Server local). Copia este archivo como server/.env.pruebas
# y completa DB_USER / DB_PASSWORD con los de tu SQL Server local.
#   npm run db:pruebas:reset   -> recrea la base con datos conocidos
#   npm run server:pruebas     -> API contra la base de pruebas
#   npm run test:e2e           -> prueba funcional con Selenium (necesita también npm run dev)
# Estas variables tienen prioridad sobre server/.env.

DB_SERVER=127.0.0.1
DB_PORT=1434
DB_USER=martin_user
DB_PASSWORD=
# Debe terminar en _Pruebas: el script de reinicio se niega a borrar cualquier otra base
DB_NAME=RepresentacionesMartinDB_Pruebas
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# SQL Server local guarda la hora local: false evita un desfase de -5 h en las fechas
DB_USE_UTC=false

# Contraseña de las cuentas de prueba (solo existe en la base _Pruebas)
TEST_USER_PASSWORD=Pruebas-Martin-2026!
