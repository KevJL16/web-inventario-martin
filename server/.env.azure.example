# Conexión a Azure SQL Database para los scripts npm *:azure
#   npm run test-db:azure
#   npm run set-password:azure -- <correo>
# Copia este archivo como server/.env.azure (ignorado por git) y completa DB_PASSWORD.
# Estas variables tienen prioridad sobre server/.env; el resto (JWT_SECRET, etc.) se toma de allí.

DB_SERVER=martin-inventario-kevin-br.database.windows.net
DB_PORT=1433
DB_USER=martin_app
DB_PASSWORD=
DB_NAME=RepresentacionesMartinDB
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
