# Copia este archivo como server/.env y completa los valores reales.
# server/.env está en .gitignore: nunca lo subas al repositorio.

PORT=5000

DB_SERVER=127.0.0.1
DB_PORT=1434
DB_USER=martin_user
DB_PASSWORD=
DB_NAME=RepresentacionesMartinDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Azure SQL: DB_ENCRYPT=true y DB_TRUST_SERVER_CERTIFICATE=false

# Tiempos de espera (ms). Azure SQL serverless tarda en reactivarse tras una pausa.
DB_CONNECTION_TIMEOUT_MS=30000
DB_REQUEST_TIMEOUT_MS=30000

# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:3000

# Secreto para firmar los JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
